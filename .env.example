# Askwise AI configuration (all FREE options only — no paid API keys needed)
# Copy this file to .env and edit if you like. Defaults work out of the box.

# Server settings
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Local AI server (Ollama). Free and open-weight: no API key required.
# Install from https://ollama.com/download/windows then:  ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Comma-separated list of free/open-weight models to try, in order.
# Only models you have pulled locally will be used.
ASKWISE_MODELS=llama3.2:3b,qwen2.5:3b,phi3:3.8b,gemma2:2b,llama3.2:1b

# NOTE: the old OPENAI_API_KEY / paid-API settings were removed on purpose.
# Askwise now runs 100% on free software and free services.
